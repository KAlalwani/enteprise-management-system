<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Invoice</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <h1>Create Invoice</h1>

  <form action="/invoices" method="POST">

    <label for="transactionType">Transaction Type:</label>
    <select id="transactionType" name="transactionType" required>
      <option value="Sale">Sale (to a customer)</option>
      <option value="Purchase">Purchase (from a supplier)</option>
    </select>
    <br>

    <div id="customerBox">
      <label for="customer">Customer:</label>
      <select id="customer" name="customer">
        <option value="">Select Customer</option>
        <% customers.forEach(customer => { %>
          <option value="<%= customer._id %>"><%= customer.name %></option>
        <% }) %>
      </select>
    </div>

    <div id="supplierBox">
      <label for="supplier">Supplier:</label>
      <select id="supplier" name="supplier">
        <option value="">Select Supplier</option>
        <% suppliers.forEach(supplier => { %>
          <option value="<%= supplier._id %>"><%= supplier.name %></option>
        <% }) %>
      </select>
    </div>

    <h3>Products</h3>
    <p id="productsHint"></p>
    <% products.forEach(product => { %>
      <div class="product-row" data-supplier="<%= product.supplier %>" data-stock="<%= product.stock %>">
        <label>
          <input type="checkbox" name="products" value="<%= product._id %>">
          <%= product.name %> (stock: <%= product.stock %>)
        </label>
        <input type="number" name="quantities[<%= product._id %>]" min="1" value="1" disabled>
      </div>
    <% }) %>

    <div id="servicesBox">
      <h3>Services</h3>
      <% services.forEach(service => { %>
        <label>
          <input type="checkbox" name="services" value="<%= service._id %>">
          <%= service.name %>
        </label>
        <br>
      <% }) %>
    </div>

    <label for="description">Description:</label>
    <textarea id="description" name="description"></textarea>
    <br>
    <button type="submit">Create Invoice</button>
  </form>

  <script>
    const typeSel = document.getElementById('transactionType')
    const customerBox = document.getElementById('customerBox')
    const supplierBox = document.getElementById('supplierBox')
    const servicesBox = document.getElementById('servicesBox')
    const customerSel = document.getElementById('customer')
    const supplierSel = document.getElementById('supplier')
    const hint = document.getElementById('productsHint')
    const rows = document.querySelectorAll('.product-row')

    function refresh() {
      const isSale = typeSel.value === 'Sale'

      customerBox.style.display = isSale ? '' : 'none'
      supplierBox.style.display = isSale ? 'none' : ''
      servicesBox.style.display = isSale ? '' : 'none'

      // disabled fields are not submitted, so only the right party is sent
      customerSel.disabled = !isSale
      supplierSel.disabled = isSale
      customerSel.required = isSale
      supplierSel.required = !isSale

      servicesBox.querySelectorAll('input').forEach(input => {
        input.disabled = !isSale
        if (!isSale) input.checked = false
      })

      hint.textContent = (!isSale && !supplierSel.value)
        ? 'Select a supplier to see its products.' : ''

      rows.forEach(row => {
        const show = isSale || (supplierSel.value && row.dataset.supplier === supplierSel.value)
        const checkbox = row.querySelector('input[type=checkbox]')
        const qty = row.querySelector('input[type=number]')

        row.style.display = show ? '' : 'none'
        if (!show) checkbox.checked = false
        checkbox.disabled = !show
        qty.disabled = !(show && checkbox.checked)

        if (isSale) qty.max = row.dataset.stock
        else qty.removeAttribute('max')
      })
    }

    typeSel.addEventListener('change', refresh)
    supplierSel.addEventListener('change', refresh)
    rows.forEach(row => row.querySelector('input[type=checkbox]').addEventListener('change', refresh))
    refresh()
  </script>
</body>
</html>