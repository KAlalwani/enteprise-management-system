<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Update</h1>
    <form action="/suppliers/<%= supplier._id %>?_method=PUT" method="post">
        <label for="name">Supplier Name:</label>
        <input type="text" id="name" name="name" value="<%= supplier.name %>" required>
        <br>

        <label for="email">Email:</label>
        <input type="text" id="email" name="email" value="<%= supplier.email %>" required>
        <br>

        <label for="phoneNumber">Phone Number:</label>
        <input type="text" id="phoneNumber" name="phoneNumber" value="<%= supplier.phoneNumber %>" required>
        <br>

        <label for="IBAN">IBAN:</label>
        <input type="text" id="IBAN" name="IBAN" value="<%= supplier.IBAN %>" required>
        <br>

        <button type="submit">Update Supplier</button>
    </form>
    
</body>
</html>