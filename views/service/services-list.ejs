<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Services</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="page-header">
    <h1>Services</h1>
    <div class="page-actions">
      <a href="/services/new">Add New Service</a>
    </div>
  </div>

  <% if (services.length > 0) { %>
    <p class="text-sm text-slate-500"><%= services.length %> service(s)</p>
    <div class="list">
      <% services.forEach(service => { %>
        <a href="/services/<%= service._id %>" class="list-row">
          <span class="avatar"><%= service.name.charAt(0).toUpperCase() %></span>
          <div class="list-main">
            <span class="list-title"><%= service.name %></span>
            <div class="list-meta">
              <% if (service.category) { %><span><%= service.category %></span><% } %>
            </div>
          </div>
          <div class="list-end font-semibold text-slate-900"><%= Number(service.price).toFixed(3) %> BHD</div>
          <span class="text-slate-400">&rsaquo;</span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty">
      <p>No services yet.</p>
      <p><a href="/services/new">Add the first service</a></p>
    </div>
  <% } %>
</body>
</html>
