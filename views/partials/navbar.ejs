<%
  const path = typeof currentPath === 'string' ? currentPath : ''
  const at = prefix => (path === prefix || path.startsWith(prefix + '/')) ? 'active' : ''
%>
<nav>
  <a href="/" class="brand">Enterprise Manager</a>

  <% if (locals.user) { %>
    <a href="/products" class="<%= at('/products') %>">Products</a>
    <a href="/services" class="<%= at('/services') %>">Services</a>
    <a href="/suppliers" class="<%= at('/suppliers') %>">Suppliers</a>
    <a href="/customers" class="<%= at('/customers') %>">Customers</a>
    <a href="/invoices" class="<%= at('/invoices') %>">Invoices</a>
    <a href="/staff/me" class="<%= path === '/staff/me' ? 'active' : '' %>">My Schedule</a>

    <% if (locals.isAdmin) { %>
      <a href="/staff" class="<%= (at('/staff') && path !== '/staff/me') ? 'active' : '' %>">Staff</a>
      <a href="/employee" class="<%= at('/employee') %>">Employees</a>
      <a href="/enterprise" class="<%= at('/enterprise') %>">Enterprise</a>
      <a href="/reminders" class="<%= at('/reminders') %>">Reminders</a>
    <% } %>

    <span class="spacer"></span>
    <span class="text-sm text-slate-500"><%= user.username %></span>
    <a href="/auth/sign-out">Sign out</a>
  <% } else { %>
    <span class="spacer"></span>
    <a href="/auth/sign-in">Sign in</a>
    <a href="/auth/sign-up">Sign up</a>
  <% } %>
</nav>