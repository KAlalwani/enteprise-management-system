<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Welcome to the Product Management System</h1>
    <form action="/products" method="post" enctype="multipart/form-data">
        <labal for="name">Product Name:</label>
        <input type="text" id="name" name="name" required>
        <br>

                  <label for="supplier">Supplier:</label>

            <select name="supplier" id="supplier">
        <% if (suppliers) { %>
          <% suppliers.forEach(supplier => { %>
            <option value="<%= supplier._id %>"><%= supplier.name %></option>
          <% }) %>
        <% } else { %>
          <option value="">No suppliers available</option>
        <% } %>
      </select><br>

        <label for="stock">Stock:</label>
        <input type="number" id="stock" name="stock" required>
        <br>

        <label for="price">Price:</label>
        <input type="number" id="price" name="price" required>
        <br>
        <label for="unitPrice">Cost Price:</label>
<input type="number" step="0.001" id="unitPrice" name="unitPrice" required>
<br>
                <label for="category">Category:</label>

            <select name="category" id="category">
        <% if (categorys) { %>
          <% categorys.forEach(category => { %>
            <option value="<%= category %>"><%= category %></option>
          <% }) %>
        <% } else { %>
          <option value="">No categorys available</option>
        <% } %>
      </select><br>
<label for="photo">Photo:</label>
<input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp">
<br>
        <button type="submit">Create Product</button>
    </form>
    
</body>
</html>